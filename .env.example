# ==============================================================================
# EMBIP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# IMPORTANT: Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (NEXT.JS) - Exposed to Browser
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="EMBIP — Enterprise Multi-Agent BI Platform"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Auth & Client (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (FASTAPI) - Private / Server-side Only
# ------------------------------------------------------------------------------
PROJECT_NAME="EMBIP Backend Engine"
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-backend-jwt-secret-key-change-in-production

# Backend Server Host/Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=your-internal-backend-api-key

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & PLATFORM - Private / Server-side Only
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Connections (Pooled & Read-Only)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_READONLY_URL=postgresql+asyncpg://readonly_user:password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. AI & LLM SERVICE CONFIGURATION - Private / Server-side Only
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. QDRANT VECTOR DATABASE CONFIGURATION - Private / Server-side Only
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=embip_document_chunks

# ------------------------------------------------------------------------------
# 6. SECURITY & GUARDRAIL SETTINGS
# ------------------------------------------------------------------------------
MAX_SQL_QUERY_LIMIT=1000
SQL_QUERY_TIMEOUT_SECONDS=5
RATE_LIMIT_PER_MINUTE=60
